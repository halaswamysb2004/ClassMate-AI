{
  "metadata": {
    "title": "ClassMate AI Foundational Stage Curriculum Starter",
    "framework": "Aligned in approach with NCERT National Curriculum Framework for Foundational Stage (NCF-FS), 2022",
    "important_note": "This is an illustrative, age-banded learning progression for ClassMate AI, not an official CBSE-prescribed Nursery/LKG/UKG chapter list. Schools may sequence and name topics differently. Learning outcomes are developmental and children progress at different rates.",
    "pedagogy": [
      "play-based learning",
      "conversation and storytelling",
      "songs and movement",
      "hands-on exploration",
      "observation-based progress tracking"
    ],
    "assessment_policy": "For Nursery, LKG and UKG, use encouraging observation and short practice activities rather than formal examinations."
  },
  "classes": {
    "nursery": {
      "label": "Nursery",
      "suggested_age": "3–4 years",
      "domains": [
        {
          "id": "language",
          "label": "Language and Communication",
          "subjects": [
            {
              "id": "english",
              "label": "English",
              "units": [
                {
                  "id": "eng-listen-speak",
                  "title": "Listening and Speaking",
                  "topics": [
                    "Listen and respond to familiar words",
                    "Name familiar people and objects",
                    "Use simple greetings",
                    "Describe a picture using one or two words"
                  ],
                  "outcomes": [
                    "Responds to simple spoken instructions",
                    "Names familiar objects",
                    "Attempts short conversations"
                  ],
                  "activities": [
                    "Picture talk",
                    "Name-that-object game",
                    "Greeting role-play"
                  ]
                },
                {
                  "id": "eng-sounds",
                  "title": "Sounds and Early Literacy",
                  "topics": [
                    "Environmental sounds",
                    "Rhymes and rhythm",
                    "Recognise own name",
                    "Explore picture books"
                  ],
                  "outcomes": [
                    "Notices and imitates familiar sounds",
                    "Joins in repeated rhymes",
                    "Shows interest in books"
                  ],
                  "activities": [
                    "Sound detective",
                    "Rhyme-and-clap",
                    "Shared picture-book reading"
                  ]
                }
              ]
            },
            {
              "id": "hindi",
              "label": "Hindi / Home Language",
              "units": [
                {
                  "id": "hin-oral",
                  "title": "मौखिक भाषा",
                  "topics": [
                    "परिचित शब्द सुनना और बोलना",
                    "अभिवादन",
                    "चित्र देखकर नाम बताना",
                    "छोटी कविताएँ और गीत"
                  ],
                  "outcomes": [
                    "सरल निर्देश समझता/समझती है",
                    "परिचित वस्तुओं के नाम बताता/बताती है"
                  ],
                  "activities": [
                    "चित्र वार्ता",
                    "कविता के साथ तालियाँ",
                    "वस्तु पहचान खेल"
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "math",
          "label": "Early Mathematical Thinking",
          "subjects": [
            {
              "id": "mathematics",
              "label": "Mathematics",
              "units": [
                {
                  "id": "math-early",
                  "title": "Number, Shape and Pattern Exploration",
                  "topics": [
                    "Sort objects by colour, shape or size",
                    "Compare big and small",
                    "Count small groups through objects (1–3)",
                    "Recognise circle and square",
                    "Explore simple repeating patterns"
                  ],
                  "outcomes": [
                    "Sorts objects by one visible attribute",
                    "Uses words such as big/small",
                    "Begins counting objects with support",
                    "Recognises familiar shapes"
                  ],
                  "activities": [
                    "Sort the toys",
                    "Find a circle around us",
                    "Clap-and-tap pattern",
                    "Count three blocks"
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "world",
          "label": "Understanding the World",
          "subjects": [
            {
              "id": "evs",
              "label": "My World",
              "units": [
                {
                  "id": "world-me",
                  "title": "Me, My Family and My Surroundings",
                  "topics": [
                    "Myself and body parts",
                    "Family and friends",
                    "Common foods",
                    "Animals around us",
                    "Plants and nature",
                    "Cleanliness and safe habits"
                  ],
                  "outcomes": [
                    "Names familiar people and body parts",
                    "Recognises common animals and foods",
                    "Practises simple hygiene routines with support"
                  ],
                  "activities": [
                    "My family picture",
                    "Healthy food basket",
                    "Animal sound match",
                    "Water-the-plant activity"
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "creative",
          "label": "Creative, Physical and Social Development",
          "subjects": [
            {
              "id": "art-play",
              "label": "Art, Movement and Play",
              "units": [
                {
                  "id": "creative-explore",
                  "title": "Create and Move",
                  "topics": [
                    "Free drawing and scribbling",
                    "Colour exploration",
                    "Music and movement",
                    "Sharing and turn-taking"
                  ],
                  "outcomes": [
                    "Explores materials creatively",
                    "Participates in movement and group play",
                    "Begins to take turns"
                  ],
                  "activities": [
                    "Finger painting",
                    "Action song",
                    "Build together"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
